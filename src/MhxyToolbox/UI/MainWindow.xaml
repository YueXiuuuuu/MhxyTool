<Window x:Class="MhxyToolbox.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MhxyToolbox.UI.ViewModels"
        Title="梦幻工具箱"
        Width="1120" Height="720"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" FontSize="16" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18">
                    <TextBlock Text="梦幻工具箱" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                    <TextBlock Text="Fantasy Toolbox" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- 版本信息 -->
                <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 · 本地工具 · 不修改游戏"
                           FontSize="10" Margin="18,0,18,14"
                           Foreground="{StaticResource TextTertiaryBrush}"/>

                <ListBox x:Name="NavList"
                         ItemsSource="{Binding NavItems}"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         Style="{StaticResource NavListBoxStyle}"
                         SelectedIndex="0"
                         SelectionChanged="OnNavSelectionChanged"
                         PreviewMouseLeftButtonDown="OnNavPreviewMouseDown"
                         PreviewMouseLeftButtonUp="OnNavPreviewMouseUp"/>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：返回 + 当前页标题 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←  返回"
                            Command="{Binding GoBackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource GhostButton}"
                            FontSize="12"
                            Padding="12,5"/>
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitleStyle}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 页面容器：首页 / 工具页 / 设置页 都在这里切换 -->
            <ContentControl x:Name="ContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
