<UserControl x:Class="MhxyToolbox.UI.Controls.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StarButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="收藏 / 取消收藏"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 卡片容器：悬停上浮 + 金色描边 + 发光 -->
    <Border x:Name="CardRoot"
            Width="252" CornerRadius="10" Cursor="Hand"
            Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            MouseLeftButtonUp="OnCardClick">
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-3" Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#E8B258" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：图标 + 名称 + 分类 + 收藏按钮 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource IconPlateBrush}">
                        <TextBlock Text="{Binding Icon}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,30,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Category}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource GoldDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnStarClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StarButtonBase}">
                            <Setter Property="Content" Value="☆"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Content" Value="★"/>
                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 第二行：描述 -->
            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>

            <!-- 第三行：版本 + 标签 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Border CornerRadius="4" Padding="6,2" Background="{StaticResource GoldFaintBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource GoldDimBrush}"/>
                </Border>
                <TextBlock Text="{Binding TagsDisplay}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
