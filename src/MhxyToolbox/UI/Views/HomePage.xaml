<UserControl x:Class="MhxyToolbox.UI.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MhxyToolbox.UI.ViewModels"
             xmlns:controls="clr-namespace:MhxyToolbox.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 头部：标题 + 搜索 ============ -->
        <Grid Grid.Row="0" Margin="28,26,28,6">
            <StackPanel>
                <TextBlock Text="梦幻西游工具箱" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="游戏数据与实用工具集合 · 新增工具自动注册、自动分类"
                           FontSize="13" Margin="0,5,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 搜索框（工具多起来以后这里同样好用） -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280"
                         Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="🔍  搜索名称 / 描述 / 标签"
                           IsHitTestVisible="False" FontSize="12"
                           Margin="13,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ============ 工具区域：动态分组 + 自适应卡片 + 滚动 ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}" Margin="28,8,28,28"
                          controls:ToolCard.ToolActivated="OnToolActivated">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolSection}">
                        <StackPanel Margin="0,14,0,4">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderText}"/>
                            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ToolCard Margin="0,0,14,14"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyTitle}" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyHint}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
