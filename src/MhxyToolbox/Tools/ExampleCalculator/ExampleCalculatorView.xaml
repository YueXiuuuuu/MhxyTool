<core:ToolPageBase x:Class="MhxyToolbox.Tools.ExampleCalculator.ExampleCalculatorView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:core="clr-namespace:MhxyToolbox.Core.Navigation">

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="示例计算器" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="用于验证「工具注册 → 发现 → 首页展示 → 点击打开」全流程的演示工具。"
                       FontSize="12" Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 计算面板 -->
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="20" CornerRadius="10"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="数字 A" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="ValueA" Width="220" HorizontalAlignment="Left" Margin="0,6,0,14"
                         Style="{StaticResource ModernTextBox}" Text="6"/>

                <TextBlock Text="运算符" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <RadioButton Content="＋" Tag="+" GroupName="op" IsChecked="True"
                                 Style="{StaticResource ChipRadioStyle}" Checked="OnOperatorChecked"/>
                    <RadioButton Content="－" Tag="-" GroupName="op"
                                 Style="{StaticResource ChipRadioStyle}" Checked="OnOperatorChecked"/>
                    <RadioButton Content="×" Tag="×" GroupName="op"
                                 Style="{StaticResource ChipRadioStyle}" Checked="OnOperatorChecked"/>
                    <RadioButton Content="÷" Tag="÷" GroupName="op"
                                 Style="{StaticResource ChipRadioStyle}" Checked="OnOperatorChecked"/>
                </StackPanel>

                <TextBlock Text="数字 B" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="ValueB" Width="220" HorizontalAlignment="Left" Margin="0,6,0,0"
                         Style="{StaticResource ModernTextBox}" Text="3"/>

                <Button Content="计  算" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" Click="OnCalculateClick"/>
            </StackPanel>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="20,16" CornerRadius="10"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="ResultText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource GoldBrightBrush}" Text="6 ＋ 3 = 9"/>
        </Border>
    </Grid>
</core:ToolPageBase>
