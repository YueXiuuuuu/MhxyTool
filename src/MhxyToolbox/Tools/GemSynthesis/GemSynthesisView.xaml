<core:ToolPageBase x:Class="MhxyToolbox.Tools.GemSynthesis.GemSynthesisView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:core="clr-namespace:MhxyToolbox.Core.Navigation">

    <core:ToolPageBase.Resources>
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CostText" TargetType="TextBlock" BasedOn="{StaticResource TableNumberText}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="CostGoldText" TargetType="TextBlock" BasedOn="{StaticResource TableNumberText}">
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </core:ToolPageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- ============ 页头 ============ -->
            <TextBlock Text="宝石合成计算器" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="按合成规则推算 1~20 级宝石的消耗与等效 1 级宝石数量，按一级宝石单价与金价折算合成成本。"
                       FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- ============ 参数输入 ============ -->
            <Border Margin="0,18,0,0" Padding="20,18" CornerRadius="10"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 一级宝石单价 -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="一级宝石单价（单位：万）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="220" HorizontalAlignment="Left" Margin="0,6,0,0"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding UnitPriceHint}" FontSize="11" Margin="0,5,0,0"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding HasUnitPriceError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="所有等级的宝石都由一级宝石合成，成本按等效 1 级宝石数量折算。"
                                   FontSize="11" Margin="0,5,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <!-- 金价 -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="金价：3000 万梦幻币折合人民币（单位：元）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="220" HorizontalAlignment="Left" Margin="0,6,0,0"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding GoldPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding GoldPriceHint}" FontSize="11" Margin="0,5,0,0"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding HasGoldPriceError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="用于把梦幻币成本换算成人民币成本。" FontSize="11" Margin="0,5,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 合成规则 ============ -->
            <Border Margin="0,14,0,0" Padding="20,16" CornerRadius="10"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="合成规则" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="1 级为基准宝石；2 级及以上："/>
                        <Run Text="N 级 = 2 颗 (N-1) 级宝石" Foreground="{StaticResource GoldBrightBrush}"/>
                        <Run Text="；12 级及以上还需额外提交同类型宝石（见表格）。"/>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="体力消耗：合成 1 个 N 级宝石消耗的体力 = 目标等级 × 10（1 级无合成，体力为 0）。"/>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="由此递推：合成 1 个 N 级宝石等效消耗 1 级宝石 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2100 … 颗；合成成本 = 等效 1 级宝石数量 × 一级宝石单价，累计成本 = 1 级到该级各合成 1 颗的等效数量之和 × 单价。"/>
                </StackPanel>
            </Border>

            <!-- ============ 明细表 ============ -->
            <Border Margin="0,14,0,0" Padding="20,16" CornerRadius="10"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="1~20 级合成消耗与成本" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="数量列无需输入即可算出；输入一级宝石单价显示梦幻币成本，再输入金价显示人民币成本。表格中「万」指万梦幻币，「元」指人民币。"/>

                    <!-- 表头：列宽必须与下方数据行一致（合计 750，与五色灵尘计算器同宽） -->
                    <Grid Height="34" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标等级" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="额外材料(12级+)" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="体力" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="等效1级数量" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="合成成本(万)" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="累计成本(万)" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="合成成本(元)" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="7" Text="累计成本(元)" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource SeparatorBrush}"/>

                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 列宽必须与表头一致 -->
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <TextBlock Grid.Column="0" Text="{Binding LevelText}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExtraMaterialText}"
                                               Style="{StaticResource CostText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StaminaText}"
                                               Style="{StaticResource TableNumberText}"
                                               Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EquivalentText}"
                                               Style="{StaticResource TableNumberText}"
                                               Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CostWanText}"
                                               Style="{StaticResource CostGoldText}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CumulativeCostWanText}"
                                               Style="{StaticResource CostGoldText}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding CostRmbText}"
                                               Style="{StaticResource CostText}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding CumulativeCostRmbText}"
                                               Style="{StaticResource CostText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ 汇总 ============ -->
            <Border Margin="0,14,0,0" Padding="20,16" CornerRadius="10"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="最高等级汇总" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SummaryHeader}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SummaryCost}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldBrightBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SummaryCumulativeCost}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldBrightBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="清空输入" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding ResetCommand}"/>
        </StackPanel>
    </ScrollViewer>
</core:ToolPageBase>
